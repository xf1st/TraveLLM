# TraveLM AI - Environment Variables
# Скопируйте этот файл в .env.local и заполните значения

# ===================
# Database (Supabase) - ОБЯЗАТЕЛЬНО
# ===================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Публичный URL сайта (реферальные ссылки в профиле; иначе берётся window.location.origin)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Service Role Key — админские API, лимиты AI, server actions (beta-feedback без anon)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ===================
# AI Providers - МИНИМУМ ОДИН ОБЯЗАТЕЛЕН
# ===================

# DeepSeek - Основной провайдер (рекомендуется)
# Получить ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key

# HuggingFace - Для Qwen и Cerebras моделей
# Получить токен: https://huggingface.co/settings/tokens
HUGGING_FACE_TOKEN=hf_your-huggingface-token

# Groq - Для быстрых Llama моделей
# Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key

# OpenRouter - Fallback провайдер (Gemini)
# Получить ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ===================
# Travelpayouts Affiliate (Booking Links + Prices API)
# ===================
# Получить маркер и токен: https://www.travelpayouts.com/programs/100/tools/api
# Маркер (Partner ID) отображается в левом нижнем углу личного кабинета
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=123456

# tp.media — ID программ (p=) из кабинета Travelpayouts для глубоких ссылок; Sputnik8 часто 1173
# NEXT_PUBLIC_TP_TR_ID=TRAVELLM
# NEXT_PUBLIC_TP_P_YANDEX_TRAVEL=
# NEXT_PUBLIC_TP_P_OSTROVOK=
# NEXT_PUBLIC_TP_P_TRIPSTER=
# NEXT_PUBLIC_TP_P_SPUTNIK8=1173
# NEXT_PUBLIC_TP_P_KIWITAXI=
# NEXT_PUBLIC_TP_P_SUTOCHNO=

# API Token для получения реальных цен на билеты
# Позволяет показывать актуальные цены из кэша Aviasales
# Документация: https://support.travelpayouts.com/hc/en-us/articles/203956163
TRAVELPAYOUTS_API_TOKEN=your_api_token_here

# Travelpayouts Drive (опционально) — Tools → Drive: скопируйте полный URL из script.src внутри выданного кода (emrld.ltd/….js?…)
# NEXT_PUBLIC_TRAVELPAYOUTS_DRIVE_SCRIPT_URL=https://emrld.ltd/NTExNDAy.js?t=511402

# ===================
# Google Places API (Опционально)
# ===================
# Для реальных отзывов о местах
# Если не указан - используются AI-генерированные отзывы
# Pricing: $20/1000 запросов
# Получить: https://console.cloud.google.com/apis/credentials
# GOOGLE_PLACES_API_KEY=AIza_your-google-key

# ===================
# Environment
# ===================
NODE_ENV=development

# Локально: вернуть старый «быстрый» dev (меньше проверок в proxy.ts). Без этого dev ≈ prod по auth-гейту.
# TRAVELLM_DEV_SKIP_PROXY_AUTH=1

# Только локально: при отсутствии service role / ошибке БД не блокировать месячные лимиты (в проде не включать).
# TRAVELLM_LIMIT_FAIL_OPEN=1
